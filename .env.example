# ===========================================
# DeepTalk Agent Configuration
# ===========================================
# Copy this file to .env and fill in your values

# LLM Backend: mlx_local (default) or remote
LLM_BACKEND=mlx_local

# Local MLX LLM Configuration (default)
MLX_LLM_MODEL=mlx-community/gemma-4-e2b-it-4bit
MLX_LLM_MAX_TOKENS=100
MLX_LLM_TEMPERATURE=0.7

# Remote LLM Configuration (optional, when LLM_BACKEND=remote)
# GEMINI_API_KEY=your_api_key
# LLM_BASE_URL=https://model-api.skyengine.com.cn/v1/chat/completions
# LLM_MODEL=qwen3.5-flash

# ASR Configuration (Local MLX offline model)
ASR_BACKEND=mlx
MLX_ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-4bit
MLX_ASR_LANGUAGE=zh

# TTS Configuration (Local MLX offline model)
TTS_BACKEND=mlx_qwen3
# Model type: qwen3_custom (default) / kokoro / qwen3 / qwen3_8bit
MLX_TTS_MODEL_TYPE=qwen3_custom
MLX_TTS_SPEED=1.0
MLX_TTS_LANGUAGE=zh
# Speaker for qwen3_custom: Vivian / Serena / Uncle_Fu / Dylan / Eric / Ryan / Aiden / Ono_Anna / Sohee
MLX_TTS_VOICE=Serena

# Hugging Face Mirror (for users in China)
# HF_ENDPOINT=https://hf-mirror.com
